{
  "name": "bac-ha-tan-an-phai",
  "version": "0.1.0",
  "private": true,
  "description": "Ứng dụng Kinh Dịch đa nền tảng, offline-first - Bắc Hà Tân An Phái",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "verify": "node scripts/verify-all.mjs",
    "build": "pnpm -r build",
    "build:web": "node scripts/build-web.mjs",
    "build:android": "node scripts/build-android.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "build:all": "node scripts/build-all.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
